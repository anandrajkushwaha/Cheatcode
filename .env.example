# Copy to .env.local for local dev, and add the same keys in
# Vercel → Settings → Environment Variables (tick Production + Preview + Development).

NEXT_PUBLIC_SITE_URL=https://cheatcodeapp.com

# Supabase → Project Settings → API Keys
# Use the PUBLISHABLE key (sb_publishable_...), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Token the scheduled writing sessions use to submit an article.
# Generate with: openssl rand -base64 32
INGEST_SECRET=

# Admin panel login (/admin). Generate the session secret the same way.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Search engine verification (optional — paste only the content value,
# not the whole <meta> tag). Add in Vercel and redeploy to verify.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
