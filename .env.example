# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=https://cheatcodeapp.com

# Supabase → Project Settings → API Keys
# Use the PUBLISHABLE key (sb_publishable_...), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
