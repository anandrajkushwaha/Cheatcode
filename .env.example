# Copy to .env.local for local dev, and add the same keys in
# Vercel → Settings → Environment Variables (tick Production + Preview + Development).

NEXT_PUBLIC_SITE_URL=https://cheatcodeapp.com

# Supabase → Project Settings → API Keys
# Use the PUBLISHABLE key (sb_publishable_...), not the legacy anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Token the scheduled writing sessions use to submit an article.
# Generate with: openssl rand -base64 32
INGEST_SECRET=

# Admin panel login (/admin). Generate the session secret the same way.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Search engine verification (optional — paste only the content value,
# not the whole <meta> tag). Add in Vercel and redeploy to verify.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Google Analytics 4 measurement ID. Falls back to the hardcoded default
# in components/GoogleAnalytics.tsx if unset.
NEXT_PUBLIC_GA_ID=G-TZC69SKP8W

# ---------------------------------------------------------------- the agent
#
# Three separate jobs, each choosing its own provider, all defaulting to
# OpenAI when OPENAI_API_KEY is set:
#
#   typed chat, resume parsing, intent  ->  OpenAI, else Gemini
#   the spoken conversation             ->  OpenAI Realtime, else Gemini Live
#   the spoken greeting                 ->  OpenAI TTS, else ElevenLabs
#
# One OpenAI key covers all three. The Gemini and ElevenLabs keys are only
# needed if you want those halves on those providers — see LIVE_PROVIDER and
# TTS_PROVIDER below.

# platform.openai.com → API keys.
OPENAI_API_KEY=

# Optional. Leave unset and the code asks the API which models this key can
# reach and picks the best one. Set one only to pin a model on purpose — a
# wrong value here fails loudly rather than being silently replaced.
OPENAI_CHAT_MODEL=
OPENAI_REALTIME_MODEL=

# Optional. Set to 1 to let OpenAI retain requests so they appear in the
# dashboard for debugging. Off by default: these requests carry resumes.
OPENAI_STORE=

# Google AI Studio → Get API key. Only needed to run the typed agent or the
# live conversation on Gemini instead.
#
# Free tier works and costs nothing, but Google's terms let them use free-tier
# content to improve their products — so it is fine for your own testing and
# not fine for real users' resumes. Enable billing before opening it up.
GEMINI_API_KEY=

# Optional, same rules as OPENAI_CHAT_MODEL.
GEMINI_CHAT_MODEL=
GEMINI_LIVE_MODEL=

# Optional escape hatches: "openai" or "gemini", to force a half rather than
# letting the presence of a key decide. Set LLM_PROVIDER=gemini and the typed
# agent goes back to Gemini without a code change, which is the fastest way
# out of a bad day on either provider.
LLM_PROVIDER=
LIVE_PROVIDER=

# ---------------------------------------------------------------- the voice
#
# The greeting. With no key at all the browser's own speechSynthesis is used,
# which works and sounds like 2011.
#
# Billed per character on both providers, so the server caches identical text
# rather than re-synthesising the same sentence.

# Which voice the agent speaks in. OpenAI's are English-first and none of them
# is Indian-accented; ELEVENLABS has one and it is preferred automatically when
# that provider is used. OPENAI_TTS_INSTRUCTIONS closes some of the gap.
OPENAI_TTS_VOICE=
OPENAI_TTS_MODEL=
OPENAI_TTS_INSTRUCTIONS=

# The spoken conversation's voice. Defaults to OPENAI_TTS_VOICE, so the agent
# does not change voice halfway through meeting somebody.
OPENAI_REALTIME_VOICE=

# Optional. "openai" or "elevenlabs", to force the greeting's provider rather
# than letting the presence of a key decide. Set TTS_PROVIDER=elevenlabs to
# get the Indian accent back.
TTS_PROVIDER=

# elevenlabs.io → Profile → API key. Only needed for the greeting, and only
# when you want it on ElevenLabs.
ELEVENLABS_API_KEY=

# Optional. Leave unset and the account is asked what voices it has, and an
# Indian-accented one is preferred. Set it to pin a specific voice — the id is
# on the voice's page in the ElevenLabs dashboard.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=

# ------------------------------------------------------------ your own traffic
# Emails whose browsing is never counted, comma separated. Signing in on any
# device with one of these sets the long-lived exclusion cookie on that device
# — which is the only mechanism that reaches a phone on mobile data, where
# there is no cookie yet, no admin session, and a carrier IP that changes.
# ADMIN_USERNAME is included automatically when it looks like an email.
ANALYTICS_OWNER_EMAILS=

# IPs never counted, comma separated. Covers every device on a network with
# nothing to set up on the device itself.
ANALYTICS_EXCLUDE_IPS=
